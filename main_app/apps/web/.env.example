# Copie para `.env.local` (fica fora do Git) e preencha com o projeto Supabase DO SITE DO MAPA
# (não o projeto de teste). supabase.com > projeto > Project Settings > API Keys / Connect.

# URL do projeto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable, sb_publishable_... ou a "anon")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (secret, sb_secret_... ou a "service_role"). SÓ no servidor do site.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão com o banco (Connect > Session pooler), com a senha do banco. Só para aplicar migrações.
SUPABASE_DB_URL=

# "Conectar Supabase" (Etapa 6): OAuth App da organização (Organization settings > OAuth Apps).
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# Chave para criptografar os tokens OAuth no banco (32 bytes em base64):
# node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
MAPA_TOKEN_ENCRYPTION_KEY=
