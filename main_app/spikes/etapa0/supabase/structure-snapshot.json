  "gatilhos": [
    {
      "nome": "on_auth_user_created",
      "schema": "auth",
      "tabela": "users",
      "funcao": "public.handle_new_user",
      "definicao": "CREATE TRIGGER on_auth_user_created AFTER INSERT ON auth.users FOR EACH ROW EXECUTE FUNCTION handle_new_user()",
      "codigo_funcao": "\nbegin\n  insert into public.profiles (id, email) values (new.id, new.email);\n  return new;\nend;\n"
    }
