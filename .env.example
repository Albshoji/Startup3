# Copie este arquivo para `.env` (que fica fora do Git) e preencha os valores.
# Nunca coloque chaves reais neste arquivo de exemplo.

# --- Etapa 0 (testes de risco 3, 5 e 6) ---
# Projeto Supabase de TESTE (supabase.com > seu projeto > Project Settings > API)
SUPABASE_URL=https://<ref-do-projeto>.supabase.co
# Chave pública "anon" (ou a "publishable", sb_publishable_...)
SUPABASE_ANON_KEY=
# Token pessoal da Management API (supabase.com/dashboard/account/tokens).
# Usado só nos testes da Etapa 0; no produto o acesso será por OAuth (Etapa 6).
SUPABASE_ACCESS_TOKEN=
